{
  "appId": "com.perqwallet.app",
  "appName": "Perq",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2530,
      "launchAutoHide": true,
      "fadeOutDuration": 250,
      "backgroundColor": "#0D1B2A",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "Camera": {
      "permissions": [
        "camera",
        "photos"
      ]
    },
    "Geolocation": {
      "permissions": [
        "location"
      ]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_perq",
      "iconColor": "#1B6C8C",
      "sound": "default"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
